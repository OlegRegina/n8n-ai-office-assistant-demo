      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const requestId = String(item.json.request_id ?? '').trim();\n\n  if (!requestId) {\n    throw new Error('Missing request_id: draft creation blocked');\n  }\n\n  return {\n    json: {\n      ...item.json,\n      draft_key: `gmail_draft:${requestId}`\n    },\n    binary: item.binary\n  };\n});"
      },
