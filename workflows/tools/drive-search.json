    {
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "queryString": "= {{ \"trashed = false and (mimeType = 'application/pdf' or mimeType = 'application/vnd.google-apps.document') and name contains '\" + String($json.query ?? \"\").trim().replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\") + \"'\" }}",
        "filter": {},
        "options": {
          "fields": [
            "id",
            "mimeType",
            "name",
            "webViewLink"
          ]
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        432,
        -208
      ],
      "id": "c7eb39b2-ccf8-455b-91ce-8ea14d08be65",
      "name": "Search files and folders",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst files = items\n  .map(item => item.json)\n  .filter(file => file.id && file.name);\n\nreturn [\n  {\n    json: {\n      success: true,\n      found: files.length > 0,\n      count: files.length,\n      files,\n      message: files.length > 0\n        ? `Found ${files.length} file(s)`\n        : 'No matching files found in Google Drive'\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -272
      ],
      "id": "429aa09d-755b-4a40-9616-e85762ed268f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "content": "# Werkzeug: Suche in Google Drive\nEingabe: query (Name oder Teil des Namens)\nSuche über die Google-Drive-API nach dem Dateinamen: PDF und Google Docs, ohne Papierkorb.\nAusgabe: id, name, mimeType, webViewLink\nLeere Anfrage → Meldung EMPTY_QUERY. Nur lesend.",
