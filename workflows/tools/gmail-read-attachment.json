    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst file = item.binary?.attachment;\n\nif (!file) {\n  throw new Error('Binary property \"attachment\" is missing');\n}\n\nconst originalName = file.fileName ?? 'document.docx';\nconst archiveName = originalName.replace(/\\.docx$/i, '') + '.zip';\n\nreturn [{\n  json: item.json,\n  binary: {\n    archive: {\n      ...file,\n      fileName: archiveName,\n      fileExtension: 'zip',\n      mimeType: 'application/zip',\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        -1424
      ],
      "id": "3f97c1c0-0a26-4348-a9b0-78c604af9a85",
      "name": "Prepare DOCX Archive"
    },
    {
      "parameters": {
        "binaryPropertyName": "archive",
        "outputPrefix": "docx_"
      },
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        1424,
        -1232
      ],
      "id": "2d21cd7d-0366-485a-8537-a22e06fb48e9",
      "name": "Decompress DOCX"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst entries = Object.entries(item.binary ?? {});\n\nfunction getPath(file) {\n  return [file.directory, file.fileName]\n    .filter(Boolean)\n    .join('/')\n    .replace(/\\\\/g, '/')\n    .replace(/^\\/+/, '');\n}\n\nconst found = entries.find(([, file]) =>\n  getPath(file) === 'word/document.xml'\n);\n\nif (!found) {\n  return [{\n    json: {\n      ...item.json,\n      success: false,\n      error: 'word/document.xml was not found inside the DOCX archive',\n      available_docx_files: entries.map(([binary_property, file]) => ({\n        binary_property,\n        path: getPath(file),\n      })),\n    },\n  }];\n}\n\nconst [binaryProperty, documentXml] = found;\n\nreturn [{\n  json: {\n    ...item.json,\n    document_xml_property: binaryProperty,\n    document_xml_path: 'word/document.xml',\n  },\n  binary: {\n    document_xml: documentXml,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        -1232
      ],
      "id": "fa962789-f50e-43a8-a540-d26fcaf946e0",
      "name": "Select DOCX Document XML"
    },
    {
      "parameters": {
        "jsCode": "// Extract DOCX Text — reinen Text aus word/document.xml holen\nconst MAX_CHARS = 8000; // Grenze für den KI-Agenten\n\nconst item = $input.first();\n\n// 1. Binärdatei als Zeichenkette lesen\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'document_xml');\nconst xml = buffer.toString('utf8');\n\n// 2. Nur sichtbaren Text <w:t>, Tabs und Umbrüche nehmen – absatzweise\nconst decode = (s) => s\n  .replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"').replace(/&apos;/g, \"'\")\n  .replace(/&amp;/g, '&');\n\nconst paragraphs = xml.split('</w:p>').map((p) =>\n  [...p.matchAll(/<w:t(?:\\s[^>]*)?>([^<]*)<\\/w:t>|<w:tab\\/>|<w:(?:br|cr)[^>]*\\/>/g)]\n    .map((m) => (m[1] !== undefined ? decode(m[1]) : m[0].startsWith('<w:tab') ? '\\t' : '\\n'))\n    .join('')\n);\n\nconst fullText = paragraphs.join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n\n// 3. Leeres Dokument – ehrlich melden\nif (!fullText) {\n  return [{ json: { ...item.json, success: false, error: 'DOCX contains no readable text' } }];\n}\n\n// 4. Nur JSON zurückgeben, Binärdaten nicht weitergeben\nconst truncated = fullText.length > MAX_CHARS;\nreturn [{\n  json: {\n    ...item.json,\n    success: true,\n    text: fullText.slice(0, MAX_CHARS),\n    char_count: fullText.length,\n    truncated,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1872,
        -1232
      ],
      "id": "0be8bbe7-98aa-4c30-b7f1-edb763cc78d3",
      "name": "Extract DOCX Text"
    },
    {
      "parameters": {
        "content": "# Werkzeug: Anhang einer E-Mail lesen\nEingabe: message_id, attachment_index\nAblauf: E-Mail mit Anhängen laden → gewünschten Anhang wählen → DOCX (Text aus word/document.xml) oder PDF (Text auslesen); andere Typen → Meldung «nicht unterstützt».\nAusgabe: success, message_id, attachment_index, filename, mime_type, text (höchstens 8000 Zeichen), char_count, truncated, error\nNur lesend: Es werden keine Dateien angelegt.",
        "height": 736,
        "width": 1600
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        240,
        -2272
      ],
      "typeVersion": 1,
      "id": "dce61042-9835-4242-a69d-89a14ec278b3",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "jsCode": "// RESULT — DOCX Text: dem KI-Agenten nur die nützlichen Felder geben\nconst j = $input.first().json;\n\nreturn [{\n  json: {\n    success: j.success,\n    message_id: j.message_id,\n    attachment_index: j.attachment_index,\n    filename: j.filename,\n    mime_type: j.mime_type,\n    text: j.text ?? '',\n    char_count: j.char_count ?? 0,\n    truncated: j.truncated ?? false,\n    error: j.error ?? null,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2128,
        -1184
      ],
      "id": "9dc156ff-68ac-49b3-bf0d-2efc305dec89",
      "name": "RESULT — DOCX Text"
    },
    {
      "parameters": {
        "jsCode": "// RESULT — Unsupported Type: ehrliche Antwort an den Agenten, wenn der Dateityp nicht unterstützt wird\nconst j = $input.first().json;\n\nreturn [{\n  json: {\n    success: false,\n    message_id: j.message_id ?? null,\n    attachment_index: j.attachment_index ?? null,\n    filename: j.filename ?? null,\n    mime_type: j.mime_type ?? null,\n    text: '',\n    char_count: 0,\n    truncated: false,\n    error: 'Unsupported attachment type. Currently supported: DOCX.',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        -880
      ],
      "id": "df36549e-b226-4fb3-bd79-94fcda1a6afa",
      "name": "RESULT — Unsupported Type"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "attachment",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1360,
        -1008
      ],
      "id": "3c0edeae-9adb-4413-85ee-befbf7360625",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "// RESULT — PDF Text: dem KI-Agenten dieselben 9 Felder wie bei DOCX geben\nconst MAX_CHARS = 8000;\n\nconst meta = $('Switch — Attachment Type').first().json; // Daten der E-Mail und des Anhangs\nconst pdf = $input.first().json;                         // Ergebnis von Extract from File\n\nconst fullText = (pdf.text ?? '').trim();\n\nreturn [{\n  json: {\n    success: fullText.length > 0,\n    message_id: meta.message_id ?? null,\n    attachment_index: meta.attachment_index ?? null,\n    filename: meta.filename ?? null,\n    mime_type: meta.mime_type ?? null,\n    text: fullText.slice(0, MAX_CHARS),\n    char_count: fullText.length,\n    truncated: fullText.length > MAX_CHARS,\n    error: fullText.length > 0 ? null : 'PDF contains no readable text (possibly a scanned image)',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        -1008
      ],
      "id": "8cdb57ae-0896-420f-9d40-c1f027533fa0",
      "name": "RESULT — PDF Text"
    }
  ],
