    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst request = $('Normalize Attachment Request').first().json;\n\nconst attachmentIndex = Number(request.attachment_index);\nconst binaryProperty = `attachment_${attachmentIndex}`;\nconst selectedFile = item.binary?.[binaryProperty];\n\nif (!selectedFile) {\n  return [{\n    json: {\n      success: false,\n      error: `Attachment index ${attachmentIndex} was not found`,\n      message_id: request.message_id,\n      attachment_index: attachmentIndex,\n      available_attachments: Object.keys(item.binary ?? {}),\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    message_id: request.message_id,\n    attachment_index: attachmentIndex,\n    source_binary_property: binaryProperty,\n    filename: selectedFile.fileName ?? '',\n    mime_type: selectedFile.mimeType ?? '',\n    file_extension: selectedFile.fileExtension ?? '',\n    size: selectedFile.fileSize ?? '',\n  },\n  binary: {\n    attachment: selectedFile,\n  },\n}];"
      },
